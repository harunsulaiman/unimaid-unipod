# Optional: POST target for /api/forms submissions
# Slack incoming webhook, Google Apps Script, Formspree, Zapier, n8n, etc.
# If unset, submissions are logged to the server console.
FORM_WEBHOOK_URL=

# Optional: email delivery via Resend (https://resend.com).
# Set both RESEND_API_KEY and FORM_EMAIL_TO to enable. FORM_EMAIL_FROM must be a
# domain you have verified in Resend (defaults to Resend's onboarding sender).
RESEND_API_KEY=
FORM_EMAIL_TO=
FORM_EMAIL_FROM="UniPod Website <forms@unipod.unimaid.edu.ng>"

